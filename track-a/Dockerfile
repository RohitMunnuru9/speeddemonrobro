FROM python:3.13-slim@sha256:d98cc29d3266e535dd9da1099688d9cb3ca4753813571e071763d17725460962 AS training
COPY training_generator.py /generator.py
RUN python3 /generator.py --seed 17 --scale full --out /training
FROM gcc:15@sha256:eb5e64286ad47187b32bda75c6b6916166ecb41da56559b8b09e0001748d2cce AS build
WORKDIR /src
COPY main.cpp io.hpp ./
COPY --from=training /training /training
RUN g++ -std=c++20 -O3 -march=x86-64-v3 -flto -DNDEBUG -pthread -static-libstdc++ -static-libgcc -fprofile-generate=/profiles -fprofile-update=atomic main.cpp -o /solution \
    && /solution /training /trainout \
    && g++ -std=c++20 -O3 -march=x86-64-v3 -flto -DNDEBUG -pthread -static-libstdc++ -static-libgcc -fprofile-use=/profiles -fprofile-correction -Werror=missing-profile main.cpp -o /solution
FROM debian:13-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad
COPY --from=build /solution /app/solution
ENTRYPOINT ["/app/solution"]
